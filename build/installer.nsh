; Custom welcome page text and sidebar for the Brick4Kidz installer.
; electron-builder includes this script before inserting the MUI welcome
; page, so redefining these here overrides the defaults.

!define MUI_WELCOMEPAGE_TITLE "Welcome to Star Team"
!define MUI_WELCOMEPAGE_TEXT "Boss, hello! This is Andrei Terekhov.$\r$\n$\r$\nPlease take a moment to meet our Star Team inside the app - open the Team section after installing.$\r$\n$\r$\nThank you!$\r$\n$\r$\nClick Next to continue."
