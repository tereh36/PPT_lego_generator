{
  "name": "star-team",
  "version": "1.6.20",
  "description": "Star Team - AI lesson generator desktop app",
  "main": "main.js",
  "author": "Andrei Terekhov",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "postbuild": "node tools/verify-packaged-deps.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "pptxgenjs": "^3.12.0",
    "jszip": "^3.10.1",
    "fast-xml-parser": "^4.5.0",
    "pdfjs-dist": "^3.11.174",
    "pngjs": "^7.0.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "dotenv": "^16.4.5"
  },
  "build": {
    "appId": "com.andreiterekhov.starteam",
    "productName": "Star Team",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "engine/**/*",
      "node_modules/**/*",
      "!engine/scripts/*.py",
      "!engine/output/**",
      "!engine/**/node_modules/**"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh",
      "artifactName": "Star-Team-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Tereh36",
      "repo": "PPT_lego_generator"
    },
    "afterPack": "tools/after-pack.js"
  }
}