{
  "name": "star-team",
  "version": "1.6.1",
  "description": "Star Team - AI lesson generator desktop app",
  "main": "main.js",
  "author": "Andrei Terekhov",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-updater": "^6.3.9",
    "pptxgenjs": "^3.12.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.andreiterekhov.starteam",
    "productName": "Star Team",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "engine/**/*",
      "!engine/output/**",
      "!engine/**/node_modules/**"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "Tereh36",
      "repo": "PPT_lego_generator"
    }
  }
}
